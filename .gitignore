# Analysis cache files (repo-dependency-analysis skill)
*/.analysis-cache/*
!*/.analysis-cache/.gitignore

# Node modules (if any skill uses npm)
node_modules/
package-lock.json

# Python virtual environments (if any skill uses Python)
venv/
.venv/
*.pyc
__pycache__/

# Logs
*.log

# OS-specific
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
setup-github.ps1
